.box{
    background-color: rgb(4, 255, 46);
    width: 200px;
    height: 200px;
    color: #ff0000;
    margin-bottom: 10px;
    display: flex;
    align-items: center; /* vertical */
    justify-content: center; /* horizontal */
}

/* selector universal */
*{
    margin: 0;
    padding: 0;
    box-sizing: border-box;
}

body{
    background-color: #ff7d04;
    padding: 3rem;
}

.container{
    background-color: #02fff2;
    padding: 2rem;
    max-width: 70%;
    margin: 0 auto;
    border-radius: 20px;
}

/* width: 100% */

figure img{
    width: 100%;
    max-width: 100%;
    border-radius: 10px;
}

.title{
    margin: 1rem 0;
    font-style: italic;
    &:hover{
        color: #248f1c;
    }

    &::after{
        content: "🍎🫐";
    }
}

